Full.Demand.Events.tally.eq_1 (id : Nat) (es : List Full.Counted.Event) :
  Full.Demand.Events.tally id es =
    List.foldl
      (fun x event =>
        match x with
        | (active, n) =>
          match event with
          | Full.Counted.Event.enter f => (active || f.id == id, n)
          | Full.Counted.Event.returning i result => (active && i != id, n)
          | Full.Counted.Event.create addr item link => (active, n + if active = true then 1 else 0)
          | x => (active, n))
