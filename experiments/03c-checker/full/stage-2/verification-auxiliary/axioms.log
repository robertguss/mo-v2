  (_x : (_ : List (String × Full.Kind)) ×' (_ : List Nat) ×' Full.Expr) :
  Full.Demand.expression._unary fs _x =
    PSigma.casesOn _x fun env credits =>
      PSigma.casesOn credits fun credits a =>
        match a with
        | Full.Expr.num n => pure credits
        | Full.Expr.bool b => pure credits
        | Full.Expr.nil => pure credits
        | Full.Expr.var name => pure credits
        | Full.Expr.bin op left right => do
          let credits ← Full.Demand.expression._unary fs ⟨env, ⟨credits, left⟩⟩
          let credits ← Full.Demand.expression._unary fs ⟨env, ⟨credits, right⟩⟩
          if (op == Full.Op.cons) = true then Full.Demand.spend credits else pure credits
        | Full.Expr.letE name bound body => do
          let kind ← Full.check fs env bound
          Full.Demand.affine name kind body
          let credits ← Full.Demand.expression._unary fs ⟨env, ⟨credits, bound⟩⟩
          Full.Demand.expression._unary fs ⟨(name, kind) :: env, ⟨credits, body⟩⟩
        | cond.ifE yes no => do
          let credits ← Full.Demand.expression._unary fs ⟨env, ⟨credits, cond⟩⟩
          let yes ← Full.Demand.expression._unary fs ⟨env, ⟨credits, yes⟩⟩
          let no ← Full.Demand.expression._unary fs ⟨env, ⟨credits, no⟩⟩
          pure (List.zipWith min yes no)
        | scrut.matchE empty head tail cell => do
          Full.Demand.affine tail Trial.Kind.list cell
          let credits ← Full.Demand.expression._unary fs ⟨env, ⟨credits, scrut⟩⟩
          let empty ← Full.Demand.expression._unary fs ⟨env, ⟨0 :: credits, empty⟩⟩
          let cell ←
            Full.Demand.expression._unary fs
                ⟨(tail, Trial.Kind.list) :: (head, Trial.Kind.number) :: env, ⟨1 :: credits, cell⟩⟩
          pure (List.zipWith min empty.tail cell.tail)
        | Full.Expr.call name args =>
          match Full.signature fs name with
          | some f =>
            have __do_jp := fun __r =>
              List.foldlM (fun credits arg => Full.Demand.expression._unary fs ⟨env, ⟨credits, arg.val⟩⟩) credits
                args.attach;
            if (!f.demanded) = true then do
              let __r ← throw (toString "ordinary callee has no demand certificate: " ++ toString name)
              __do_jp __r
            else __do_jp ()
          | x => throw (toString "unknown function " ++ toString name)
