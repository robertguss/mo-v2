      | c.ifE t e =>
        Full.Demand.occurrences._unary id ⟨c, env⟩ +
          max (Full.Demand.occurrences._unary id ⟨t, env⟩) (Full.Demand.occurrences._unary id ⟨e, env⟩)
      | s.matchE n h t c =>
        Full.Demand.occurrences._unary id ⟨s, env⟩ +
