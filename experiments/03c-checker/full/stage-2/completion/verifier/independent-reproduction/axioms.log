Full.Demand.occurrences._unary.eq_def (id : Nat) (_x : (_ : Full.Expr) ×' Trial.FEnv) :
  Full.Demand.occurrences._unary id _x =
    PSigma.casesOn _x fun e env =>
      match e with
      | Full.Expr.num n => 0
      | Full.Expr.bool b => 0
      | Full.Expr.nil => 0
      | Full.Expr.var x => if (Trial.lookupF env x == some (some id)) = true then 1 else 0
      | Full.Expr.bin op a b => Full.Demand.occurrences._unary id ⟨a, env⟩ + Full.Demand.occurrences._unary id ⟨b, env⟩
      | Full.Expr.letE x a b =>
        Full.Demand.occurrences._unary id ⟨a, env⟩ + Full.Demand.occurrences._unary id ⟨b, (x, none) :: env⟩
      | c.ifE t e =>
        Full.Demand.occurrences._unary id ⟨c, env⟩ +
          max (Full.Demand.occurrences._unary id ⟨t, env⟩) (Full.Demand.occurrences._unary id ⟨e, env⟩)
      | s.matchE n h t c =>
        Full.Demand.occurrences._unary id ⟨s, env⟩ +
          max (Full.Demand.occurrences._unary id ⟨n, env⟩)
            (Full.Demand.occurrences._unary id ⟨c, (t, none) :: (h, none) :: env⟩)
      | Full.Expr.call name args => (List.map (fun a => Full.Demand.occurrences._unary id ⟨a.val, env⟩) args.attach).sum
