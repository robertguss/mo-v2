Full.Demand.Affinity.StateCertified.eq_1 (root : Nat) (p : Full.Program) (out : Full.Kind) (s : Full.Counted.State) :
  Full.Demand.Affinity.StateCertified root p out s =
    ∃ ks fs,
      Full.Proofs.CountedTyping.SlotsTyped s.slots ks ∧
        List.map Full.Counted.Frame.id s.frames = List.map Prod.fst fs ∧
          Full.Demand.Affinity.Work root p s.bindings out s.tasks ks fs ∧
            ∀ (edge : Nat × Full.Value), edge ∈ s.edges → Trial.PlainValue.kind edge.snd = Trial.Kind.list
