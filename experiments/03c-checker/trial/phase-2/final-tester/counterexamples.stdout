forgetsRest: constant 7; unused xs input is released before evaluation
CASE forgetsRest violates Promise D; rule Trial.Rule.forgetsRest
start = { cells := [{ addr := 1, item := 11, link := some 2, count := 1 }, { addr := 2, item := 22, link := none, count := 1 }],
  inputs := [("xs", Trial.RawValue.list (some 1))],
  outside := [] }
wellFormed = Except.ok (Trial.Kind.number); validStart = Except.ok ()
plainAnswer = Except.ok (Trial.PlainValue.num 7)
approved A,B,C,D = (true, true, true, true)
named A,B,C,D = (true, true, true, false)
named C1,C2 = (true, true)
finalAnswer = Except.ok (Trial.PlainValue.num 7)
full named outcome = { result := Trial.Result.answer (Trial.RawValue.num 7),
  memory := { cells := [{ addr := 2, item := 22, link := none, count := 1, status := Trial.Status.live }],
              next := 3,
              record := [Trial.MemEvent.released 1] },
  log := [Trial.LogEvent.free 1],
  record := [Trial.MemEvent.released 1],
  states := [{ kind := Trial.StepKind.holderGivenUp,
               memory := [{ addr := 1, item := 11, link := some 2, count := 0, status := Trial.Status.live },
                          { addr := 2, item := 22, link := none, count := 1, status := Trial.Status.live }],
               bindings := [{ id := 0,
                              name := "xs",
                              value := Trial.RawValue.list (some 1),
                              status := Trial.BStatus.givenUp }],
               pending := [],
               outside := [],
               setAside := [],
               branchValue := none },
             { kind := Trial.StepKind.cellFreed,
               memory := [{ addr := 2, item := 22, link := none, count := 1, status := Trial.Status.live }],
               bindings := [{ id := 0,
                              name := "xs",
                              value := Trial.RawValue.list (some 1),
                              status := Trial.BStatus.givenUp }],
               pending := [Trial.RawValue.list (some 2)],
               outside := [],
               setAside := [],
               branchValue := none },
             { kind := Trial.StepKind.holderForgotten,
               memory := [{ addr := 2, item := 22, link := none, count := 1, status := Trial.Status.live }],
               bindings := [{ id := 0,
                              name := "xs",
                              value := Trial.RawValue.list (some 1),
                              status := Trial.BStatus.givenUp }],
               pending := [],
               outside := [],
               setAside := [],
               branchValue := none },
             { kind := Trial.StepKind.start,
               memory := [{ addr := 2, item := 22, link := none, count := 1, status := Trial.Status.live }],
               bindings := [{ id := 0,
                              name := "xs",
                              value := Trial.RawValue.list (some 1),
                              status := Trial.BStatus.givenUp }],
               pending := [],
               outside := [],
               setAside := [],
               branchValue := none },
             { kind := Trial.StepKind.end,
               memory := [{ addr := 2, item := 22, link := none, count := 1, status := Trial.Status.live }],
               bindings := [{ id := 0,
                              name := "xs",
                              value := Trial.RawValue.list (some 1),
                              status := Trial.BStatus.givenUp }],
               pending := [],
               outside := [],
               setAside := [],
               branchValue := none }] }
EXPECTED VIOLATION CONFIRMED
